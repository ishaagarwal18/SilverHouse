# ==============================================================================
# SILVERHOUSE ACTIVE FRONTEND ENVIRONMENT CONFIGURATION
#
# 👉 HOW TO CHANGE THE ACTIVE ENVIRONMENT:
# Simply uncomment ONE of the 3 options below and comment out the other two,
# then restart your dev server (npm run dev).
# ==============================================================================

# --- [OPTION 1: LOCALHOST] (Test local frontend + local backend) ---
# VITE_ENV_NAME=localhost
# VITE_API_URL=http://localhost:5001/api

# --- [OPTION 2: VERCEL & RENDER] (Staging / Cloud Preview) ---
# VITE_ENV_NAME=render
# VITE_API_URL=https://silverhouse-backend.onrender.com/api

# --- [OPTION 3: PRODUCTION] (Live Server api.silverhouseindia.com) ---
VITE_ENV_NAME=production
VITE_API_URL=https://api.silverhouseindia.com/api

{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.silverhouseindia.com/api/:match*"
    },
    {
      "source": "/product_image/:match*",
      "destination": "https://api.silverhouseindia.com/product_image/:match*"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://api.silverhouseindia.com/docs/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}